# Скопируйте этот файл в .env.local и вставьте ключ из https://aistudio.google.com/apikey
# Без ключа сайт работает в демо-режиме.
GEMINI_API_KEY=
# Необязательно: другая модель Gemini
# GEMINI_MODEL=gemini-3.5-flash-lite

# База данных Supabase (Project Settings → API Keys / Data API).
# Ключи только здесь и в Vercel → Settings → Environment Variables, никогда в коде и не в чате.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Секретный ключ: sb_secret_… (или старый service_role). Публичный ключ не нужен.
SUPABASE_SECRET_KEY=
